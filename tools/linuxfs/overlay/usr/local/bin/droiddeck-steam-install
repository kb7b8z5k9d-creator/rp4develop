#!/bin/bash
set -eu
# Valve's three client hosts: one that can't be reached is followed by the next on the next try; each part is checked against the manifest's sha2.
cdns="https://client-update.fastly.steamstatic.com https://client-update.akamai.steamstatic.com https://client-update.steamstatic.com"
steam_channel=steamdeck_publicbeta
manifest=steam_client_${steam_channel}_linuxarm64
steam_root=${XDG_DATA_HOME:-$HOME/.local/share}/Steam
stamp=$steam_root/package/droiddeck-installed
legacy_stamp=$steam_root/package/bannerlator-installed
unconfirmed=$steam_root/package/droiddeck-unconfirmed
repair_request=$HOME/.bl-steam-repair
if [ -f "$legacy_stamp" ] && [ ! -f "$stamp" ]; then
  mv -f "$legacy_stamp" "$stamp" || true
fi
repair=""
if [ -e "$repair_request" ]; then
  repair="requested"
elif [ -f "$unconfirmed" ] && ! grep -qx repaired "$unconfirmed" \
    && [ "$(grep -cx start "$unconfirmed")" -ge 2 ]; then
  repair="the client was started $(grep -cx start "$unconfirmed") times without showing anything"
fi
if [ -n "$repair" ]; then
  echo "== STEP $(date -u +%H:%M:%S) repairing the Steam client ($repair)"
  rm -f "$stamp" "$legacy_stamp" "$steam_root/.crash" "$steam_root/steam.pid" \
    "$steam_root"/package/steam_client_*.manifest "$steam_root"/package/steam_client_*.installed
  for part in "$steam_root"/package/*.zip.*; do
    [ -f "$part" ] || continue
    sum=${part##*.}
    sum=${sum%%_*}
    case $sum in
      *[!0-9a-f]*|"") continue ;;
    esac
    [ ${#sum} -eq 40 ] || continue
    [ "$(sha1sum "$part" | cut -d' ' -f1)" = "$sum" ] || rm -f "$part"
  done
fi
[ -x "$steam_root/steamrtarm64/steam" ] && [ -f "$stamp" ] && exit 0

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# A dropped connection (a paused session, a Wi-Fi hiccup) costs one file, not the whole first start.
# A connection that freezes instead of dropping (across a pause or a Wi-Fi switch) would hang curl for
# good, so it gives up on one that takes 20 s to open or moves under 1 KB/s for a minute. An HTTP
# error (exit 22) is not tried again: the file is not there.
# When every try fails without an HTTP answer, the last line says the servers could not be reached:
# the app looks for it to tell the player to check the connection or a VPN/accelerator app
# (every try refused within 11 ms behind a VPN, and the session just ended).
UNREACHABLE="droiddeck-steam-install: could not reach Steam's download servers"
read -r -a hosts <<< "$cdns"
fetch() {
  local attempt rc host
  for attempt in 1 2 3 4 5; do
    host=${hosts[0]}
    if curl -fsSL "$host/$1" -o "$2" --connect-timeout 20 --speed-limit 1024 --speed-time 60; then return 0; else rc=$?; fi
    rm -f "$2"
    [ "$rc" -ne 22 ] || break
    [ "$attempt" -lt 5 ] || break
    # Only a connection that failed before any answer (curl 6, 7, 28, 35, 52, 56) moves to the next host.
    case $rc in
      6|7|28|35|52|56) hosts=("${hosts[@]:1}" "$host") ;;
    esac
    echo "== droiddeck-steam-install: $1 failed (try $attempt of 5), trying again (curl exit $rc from ${host#https://})" >&2
    sleep $((attempt * 2))
  done
  if [ "$rc" -eq 22 ]; then
    echo "droiddeck-steam-install: $1: the server has no such file (HTTP error)" >&2
  elif [ "$rc" -ne 23 ]; then
    echo "$UNREACHABLE ($1, curl exit $rc after 5 tries)" >&2
  fi
  exit 1
}
fetch "$manifest" "$work/manifest"
version=$(awk -F'"' '$2 == "version" { print $4; exit }' "$work/manifest")
awk -F'"' '
  /^\t"/ && NF >= 3 && $4 == "" { block = $2 }
  $2 == "file" { file[block] = $4 }
  $2 == "sha2" { sha[block] = $4 }
  END { for (b in file) if (b ~ /_all$/ || b ~ /_linuxarm64_linuxarm64$/) print b, file[b], sha[b] }
' "$work/manifest" | sort > "$work/parts"
[ -s "$work/parts" ] || { echo "droiddeck-steam-install: no client components in $manifest" >&2; exit 1; }
total=$(grep -c . "$work/parts" 2>/dev/null || echo 0)

mkdir -p "$steam_root/package"
while read -r block file sum; do
  i=$((${i:-0} + 1))
  echo "== STEP $(date -u +%H:%M:%S) downloading Steam: $block ($i/$total)"
  fetch "$file" "$work/$file"
  echo "$sum  $work/$file" | sha256sum -c --quiet
  unzip -qo "$work/$file" -d "$steam_root"
  rm -f "$work/$file"
done < "$work/parts"
find "$steam_root" -depth -name '*\\*' | while read -r odd; do
  fixed=${odd//\\//}
  mkdir -p "$(dirname "$fixed")"
  if [ -d "$odd" ]; then
    cp -a "$odd/." "$fixed/" && rm -rf "$odd"
  else
    mv -f "$odd" "$fixed"
  fi
done
echo "$steam_channel" > "$steam_root/package/beta"
ln -sfn "$steam_root/steamrtarm64" "$steam_root/steamrtarm32"
chmod +x "$steam_root/steamrtarm64/steam" 2>/dev/null || true
mkdir -p "$HOME/.steam"
ln -sfn "$steam_root" "$HOME/.steam/root"
ln -sfn "$steam_root" "$HOME/.steam/steam"
ln -sfn "$steam_root/steamrtarm64" "$HOME/.steam/bin64"
ln -sfn "$steam_root/linuxarm64" "$HOME/.steam/sdk64"
ln -sfn "$steam_root/linuxarm64" "$HOME/.steam/sdkarm64"
ln -sfn "$steam_root/steamrtarm64" "$HOME/.steam/binarm64"
ln -sfn "$steam_root/linux32" "$HOME/.steam/sdk32"
echo "$version" > "$stamp"
if [ -n "$repair" ]; then
  echo repaired > "$unconfirmed"
  rm -f "$repair_request"
fi
